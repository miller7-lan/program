/* ─────────────────────────────────────────────────────────
   assets/style.qss  —  利润助手 全局样式表（浅色，针对 Win10 调整）
   {ASSETS} 会在加载时替换为资源目录的绝对路径
───────────────────────────────────────────────────────── */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
}

QWidget {
    color: #1D2130;
    font-size: 14px;
}

QMainWindow, #AppRoot, #PageContent, #PageScroll, #PageScroll > QWidget > QWidget {
    background-color: #F3F4F8;
}

QToolTip {
    background-color: #1D2130;
    color: #FFFFFF;
    border: none;
    padding: 6px 9px;
    font-size: 12px;
}

/* ──── 侧边栏 ──── */
#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E4E7EF;
}

#BrandTitle {
    font-size: 17px;
    font-weight: 700;
    color: #1D2130;
}

#BrandSubtitle {
    font-size: 12px;
    color: #8C92A6;
}

#NavButton {
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 10px;
    color: #5B6175;
    background: transparent;
    font-size: 14px;
}

#NavButton:hover {
    background-color: #F3F4F8;
    color: #1D2130;
}

#NavButton:checked {
    background-color: #EEECFD;
    color: #5B4FE0;
    font-weight: 600;
}

#SyncPanel {
    background-color: #F8F9FC;
    border: 1px solid #E4E7EF;
    border-radius: 12px;
}

#SyncTitle {
    font-size: 13px;
    font-weight: 600;
}

#SyncTitle[tone="ok"] { color: #1A9E5C; }
#SyncTitle[tone="error"] { color: #D9363E; }
#SyncTitle[tone="busy"] { color: #5B4FE0; }
#SyncTitle[tone="off"] { color: #8C92A6; }

#SyncDetail {
    font-size: 12px;
    color: #8C92A6;
}

#VersionLabel {
    color: #A3A8B8;
    font-size: 11px;
}

/* ──── 页面文字 ──── */
#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #1D2130;
}

#PageSubtitle {
    font-size: 13px;
    color: #8C92A6;
}

#SectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #1D2130;
}

#SectionHint, #Hint {
    font-size: 12px;
    color: #8C92A6;
}

#ErrorText {
    font-size: 12px;
    color: #D9363E;
}

#OkText {
    font-size: 12px;
    color: #1A9E5C;
}

#WarnText {
    font-size: 12px;
    color: #C77700;
}

/* ──── 卡片 ──── */
#Card, #StatCard, #CategoryCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EF;
    border-radius: 14px;
}

#StatTitle {
    font-size: 13px;
    color: #5B6175;
}

#StatValue {
    font-size: 26px;
    font-weight: 700;
    color: #1D2130;
}

#StatValue[tone="negative"] { color: #D9363E; }

#StatSub {
    font-size: 12px;
    color: #8C92A6;
}

#StatSub[tone="up"] { color: #1A9E5C; }
#StatSub[tone="down"] { color: #D9363E; }
#StatSub[tone="warn"] { color: #C77700; }

#Badge {
    border-radius: 10px;
    padding: 3px 9px;
    font-size: 12px;
    font-weight: 600;
}

#Badge[tone="success"] { background-color: #E6F6EE; color: #1A9E5C; }
#Badge[tone="neutral"] { background-color: #F0F1F5; color: #5B6175; }
#Badge[tone="warning"] { background-color: #FFF4E0; color: #C77700; }
#Badge[tone="danger"]  { background-color: #FDECEC; color: #D9363E; }
#Badge[tone="accent"]  { background-color: #EEECFD; color: #5B4FE0; }

/* ──── 按钮 ──── */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E5;
    border-radius: 9px;
    padding: 7px 14px;
    color: #1D2130;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #F8F9FC;
    border-color: #C3C8D6;
}

QPushButton:pressed {
    background-color: #EEF0F5;
}

QPushButton:disabled {
    color: #A3A8B8;
    background-color: #F6F7FA;
    border-color: #E4E7EF;
}

QPushButton[variant="primary"] {
    background-color: #5B4FE0;
    border: 1px solid #5B4FE0;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[variant="primary"]:hover {
    background-color: #4C40D0;
    border-color: #4C40D0;
}

QPushButton[variant="primary"]:pressed {
    background-color: #4136B8;
}

QPushButton[variant="primary"]:disabled {
    background-color: #B9B3F2;
    border-color: #B9B3F2;
    color: #FFFFFF;
}

QPushButton[variant="soft"] {
    background-color: #EEECFD;
    border: 1px solid #EEECFD;
    color: #5B4FE0;
    font-weight: 600;
}

QPushButton[variant="soft"]:hover {
    background-color: #E2DFFB;
    border-color: #E2DFFB;
}

QPushButton[variant="danger"] {
    background-color: #FFFFFF;
    border: 1px solid #F3C4C6;
    color: #D9363E;
}

QPushButton[variant="danger"]:hover {
    background-color: #FDECEC;
    border-color: #ECA9AC;
}

QPushButton[variant="ghost"] {
    background: transparent;
    border: 1px solid transparent;
    color: #5B6175;
    padding: 6px 8px;
}

QPushButton[variant="ghost"]:hover {
    background-color: #EEF0F5;
    color: #1D2130;
}

QPushButton[variant="icon"] {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E5;
    border-radius: 9px;
    padding: 6px;
    min-width: 22px;
}

QPushButton[variant="icon"]:hover {
    background-color: #F3F4F8;
}

QPushButton[variant="chip"] {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EF;
    border-radius: 15px;
    padding: 5px 13px;
    font-size: 13px;
    color: #5B6175;
}

QPushButton[variant="chip"]:hover {
    background-color: #F5F4FE;
    border-color: #D9D5FA;
    color: #5B4FE0;
}

QPushButton[variant="chip"]:checked {
    background-color: #5B4FE0;
    border-color: #5B4FE0;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton[variant="token"] {
    background-color: #FFFFFF;
    border: 1px solid #DCD8FA;
    border-radius: 8px;
    padding: 5px 11px;
    color: #4C40D0;
    font-size: 13px;
}

QPushButton[variant="token"]:hover {
    background-color: #EEECFD;
}

QPushButton[variant="token-total"] {
    background-color: #EEECFD;
    border: 1px solid #DCD8FA;
    border-radius: 8px;
    padding: 5px 11px;
    color: #4C40D0;
    font-size: 13px;
    font-weight: 700;
}

QPushButton[variant="token-total"]:hover {
    background-color: #E2DFFB;
}

QPushButton[variant="op"] {
    background-color: #F3F4F8;
    border: 1px solid #E4E7EF;
    border-radius: 8px;
    padding: 5px 0px;
    min-width: 40px;
    font-size: 15px;
    font-weight: 700;
    color: #1D2130;
}

QPushButton[variant="op"]:hover {
    background-color: #E9EBF1;
}

/* ──── 分段选择 ──── */
#Segmented {
    background-color: #F0F1F5;
    border-radius: 9px;
}

#Segmented QPushButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 4px 12px;
    border-radius: 7px;
    color: #5B6175;
    font-size: 13px;
}

#Segmented QPushButton:hover {
    color: #1D2130;
}

#Segmented QPushButton:checked {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EF;
    color: #1D2130;
    font-weight: 600;
}

/* ──── 输入框 ──── */
QLineEdit, QTextEdit, QPlainTextEdit, QDateEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D5D9E5;
    border-radius: 9px;
    padding: 6px 10px;
    color: #1D2130;
    selection-background-color: #C9C3F7;
    selection-color: #1D2130;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QDateEdit:hover {
    border-color: #C3C8D6;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QDateEdit:focus {
    border: 1px solid #5B4FE0;
}

QLineEdit:disabled, QDateEdit:disabled {
    background-color: #F6F7FA;
    color: #A3A8B8;
}

QLineEdit[invalid="true"] {
    border: 1px solid #D9363E;
    background-color: #FFF7F7;
}

#AmountInput {
    font-size: 14px;
    padding: 6px 10px;
}

#FormulaInput {
    font-size: 15px;
    padding: 9px 12px;
}

QDateEdit {
    padding-right: 28px;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}

QDateEdit::down-arrow {
    image: url({ASSETS}/icons/chevron-down.svg);
    width: 13px;
    height: 13px;
}

/* ──── 日历弹窗 ──── */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E4E7EF;
}

QCalendarWidget QToolButton {
    color: #1D2130;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: #F3F4F8;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url({ASSETS}/icons/chevron-left.svg);
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url({ASSETS}/icons/chevron-right.svg);
}

QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
}

QCalendarWidget QSpinBox {
    border: 1px solid #D5D9E5;
    padding: 2px 6px;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #5B4FE0;
    selection-color: #FFFFFF;
    outline: 0;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #C3C8D6;
}

/* ──── 复选框 ──── */
QCheckBox {
    spacing: 8px;
    color: #1D2130;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C3C8D6;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #5B4FE0;
}

QCheckBox::indicator:checked {
    background-color: #5B4FE0;
    border-color: #5B4FE0;
    image: url({ASSETS}/icons/check-white.svg);
}

/* ──── 表格 ──── */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAFBFD;
    border: 1px solid #E4E7EF;
    border-radius: 12px;
    gridline-color: #EEF0F5;
    selection-background-color: #EEECFD;
    selection-color: #1D2130;
    outline: 0;
}

QTableWidget::item {
    padding: 4px 10px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #EEECFD;
    color: #1D2130;
}

QHeaderView::section {
    background-color: #F8F9FC;
    color: #5B6175;
    font-weight: 600;
    font-size: 13px;
    border: none;
    border-bottom: 1px solid #E4E7EF;
    padding: 8px 10px;
}

QTableCornerButton::section {
    background-color: #F8F9FC;
    border: none;
}

/* ──── 列表 ──── */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EF;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}

QListWidget::item {
    padding: 7px 10px;
    border-radius: 7px;
    color: #1D2130;
}

QListWidget::item:hover {
    background-color: #F3F4F8;
}

QListWidget::item:selected {
    background-color: #EEECFD;
    color: #4C40D0;
}

#RecentList {
    border: none;
    padding: 0px;
    background: transparent;
}

#RecentList::item {
    padding: 0px;
    border-radius: 9px;
}

#RecentList::item:selected {
    background-color: #F3F4F8;
}

#RecentDate {
    font-size: 14px;
    font-weight: 600;
}

#RecentNote {
    font-size: 12px;
    color: #8C92A6;
}

#RecentProfit {
    font-size: 14px;
    font-weight: 700;
}

#RecentProfit[tone="negative"] { color: #D9363E; }

/* ──── 录入页 ──── */
#CategoryTitle {
    font-size: 15px;
    font-weight: 700;
}

#CategoryMeta {
    font-size: 12px;
    color: #8C92A6;
}

#CategoryTotal {
    font-size: 15px;
    font-weight: 700;
    color: #5B4FE0;
}

#CategoryTotal[tone="negative"] { color: #D9363E; }

#FieldLabel {
    font-size: 13px;
    color: #5B6175;
}

#ProfitPanel {
    background-color: #EEECFD;
    border: 1px solid #E2DFFB;
    border-radius: 12px;
}

#ProfitCaption {
    font-size: 12px;
    color: #5B4FE0;
}

#ProfitValue {
    font-size: 22px;
    font-weight: 700;
    color: #4C40D0;
}

#ProfitValue[tone="negative"] { color: #D9363E; }
#ProfitValue[tone="error"] { color: #C77700; font-size: 15px; }

/* ──── 历史页 ──── */
#SummaryValue {
    font-size: 17px;
    font-weight: 700;
}

#SummaryValue[tone="negative"] { color: #D9363E; }

#SummaryCaption {
    font-size: 12px;
    color: #8C92A6;
}

/* ──── 设置页 ──── */
#ListCaption {
    font-size: 13px;
    font-weight: 600;
    color: #5B6175;
}

#MonoValue {
    font-family: "Consolas", "Menlo", monospace;
    font-size: 12px;
    color: #5B6175;
}

/* ──── 滚动条 ──── */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #D5D9E5;
    border-radius: 3px;
    min-height: 32px;
    margin: 0px 2px;
}

QScrollBar::handle:vertical:hover {
    background: #B7BCCB;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #D5D9E5;
    border-radius: 3px;
    min-width: 32px;
    margin: 2px 0px;
}

QScrollBar::handle:horizontal:hover {
    background: #B7BCCB;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ──── 菜单 / 对话框 ──── */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E4E7EF;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #EEECFD;
    color: #4C40D0;
}

QMessageBox, QInputDialog, QDialog {
    background-color: #FFFFFF;
}

QMessageBox QPushButton, QInputDialog QPushButton, QDialogButtonBox QPushButton {
    min-width: 78px;
}

/* ──── 提示气泡 ──── */
#Toast {
    background-color: rgba(29, 33, 48, 235);
    color: #FFFFFF;
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 13px;
}

#Toast[tone="error"] {
    background-color: rgba(190, 40, 48, 240);
}

#Toast[tone="success"] {
    background-color: rgba(20, 120, 72, 240);
}

/* ──── 禁用状态（必须写在各变体之后，否则会被变体样式覆盖） ──── */
QPushButton[variant="danger"]:disabled,
QPushButton[variant="soft"]:disabled,
QPushButton[variant="chip"]:disabled,
QPushButton[variant="token"]:disabled,
QPushButton[variant="token-total"]:disabled,
QPushButton[variant="icon"]:disabled,
QPushButton[variant="ghost"]:disabled {
    color: #A3A8B8;
    background-color: #F6F7FA;
    border-color: #E4E7EF;
}

QPushButton[variant="ghost"]:disabled {
    background: transparent;
    border-color: transparent;
}

/* ──── 历史表格横向滚动条：加粗，方便拖动查看右侧各列 ──── */
#HistoryTable QScrollBar:horizontal {
    height: 16px;
    background: #ECEAFB;
    border-radius: 8px;
    margin: 2px 4px 4px 4px;
}

#HistoryTable QScrollBar::handle:horizontal {
    background: #BDB5F8;
    border-radius: 6px;
    min-width: 72px;
    margin: 2px;
}

#HistoryTable QScrollBar::handle:horizontal:hover {
    background: #8D80F0;
}

QPlainTextEdit#FormulaInput {
    font-size: 15px;
    padding: 6px 8px;
}

QPlainTextEdit[invalid="true"] {
    border: 1px solid #D9363E;
    background-color: #FFF7F7;
}
