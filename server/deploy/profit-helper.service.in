[Unit]
Description=Profit Helper sync server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=profit-helper
Group=profit-helper
ExecStart=/usr/bin/python3 -I /opt/profit-helper/profit_sync_server.py serve --config /etc/profit-helper/config.json
# 证书由 systemd 以 root 身份读取后交给服务，服务本身无权读取 /etc/letsencrypt
LoadCredential=tls-cert:/etc/letsencrypt/live/@DOMAIN@/fullchain.pem
LoadCredential=tls-key:/etc/letsencrypt/live/@DOMAIN@/privkey.pem
StateDirectory=profit-helper
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# 资源上限：即使异常也不会挤占同机的代理与其他服务
MemoryHigh=48M
MemoryMax=64M
CPUQuota=50%
TasksMax=64
LimitNOFILE=1024

# 沙箱加固
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
